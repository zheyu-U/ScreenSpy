<Window x:Class="ScreenSpy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenSpy"
        mc:Ignorable="d"
        Title="ScreenSpy" Height="620" Width="760">
    <!-- 主界面骨架：只做“看得见运行状态”这件事（真正的设置/7 天图属后续里程碑）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" Text="ScreenSpy" />
            <TextBlock x:Name="OptionsText" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" FontSize="11" />

            <Border x:Name="WarnBorder" Margin="0,12,0,0" Padding="10" CornerRadius="4"
                    Background="#FFF4E5" BorderBrush="#E8A33D" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="WarnText" Foreground="#8A5A00" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="今日真实活跃" Margin="0,18,0,0" Foreground="#666" />
            <TextBlock x:Name="TodayText" FontSize="40" FontWeight="Bold" Text="0:00:00" />

            <TextBlock x:Name="StateText" Margin="0,2,0,0" FontSize="15" Text="—" />

            <TextBlock x:Name="NonAppText" Margin="0,6,0,0" FontSize="12" Foreground="#555" TextWrapping="Wrap" Text="—" />

            <!-- 卡片形态与位置（M7）：形态 = 常态选择（持久）；调整位置 = 临时进入可拖形态。 -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PositionButton" Padding="12,4" Content="调整位置"
                        Visibility="Collapsed" Click="PositionButton_Click" />
                <Button x:Name="ModeButton" Margin="8,0,0,0" Padding="12,4" Content="切换为浮动窗口"
                        Visibility="Collapsed" Click="ModeButton_Click" />
            </StackPanel>
            <TextBlock x:Name="PositionHintText" Margin="0,6,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap" />

            <TextBlock x:Name="SessionText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#333" />
            <TextBlock x:Name="SourceText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333" />

            <TextBlock Text="当前前台" Margin="0,16,0,0" Foreground="#666" />
            <TextBlock x:Name="CurrentAppText" FontSize="15" Text="—" TextWrapping="Wrap" />

            <TextBlock Text="Top 5（今日）" Margin="0,16,0,0" Foreground="#666" />
            <ListBox x:Name="TopList" Height="140" Margin="0,4,0,0" FontFamily="Consolas" />

            <TextBlock x:Name="ConservationText" Margin="0,6,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Text="聚合落库（M4）" Margin="0,18,0,0" Foreground="#666" />
            <TextBlock x:Name="StoreText" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

            <TextBlock Text="原始活动日志（M3）" Margin="0,14,0,0" Foreground="#666" />
            <TextBlock x:Name="LogText" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

            <TextBlock x:Name="FooterText" Margin="0,18,0,0" Foreground="#888" FontSize="11" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Window>
